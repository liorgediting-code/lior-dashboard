# Supabase (local dev via `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Marketing API (leave META_USE_MOCK=true until a real Meta App exists)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
META_USE_MOCK=true

# Green API (WhatsApp) — leave GREEN_API_USE_MOCK=true until a real instance exists
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_USE_MOCK=true

# Telegram alerts (owner-facing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Insights panel (opt-in, phase 7)
ANTHROPIC_API_KEY=

# Shared secret that n8n/Make/Vercel Cron must send as `x-cron-secret` to hit /api/cron/* routes
CRON_SECRET=dev-local-secret

# Base URL used when building outbound links (magic links, webhooks)
APP_BASE_URL=http://localhost:3000
